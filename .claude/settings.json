{
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "Bash(npx firebase emulators:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*service-account*.json)",
      "Bash(firebase deploy*--project noor-prod*)",
      "Bash(npx firebase deploy*--project noor-prod*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
